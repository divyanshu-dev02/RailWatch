# =========================================================================
# RailWatch Environment Configuration Variables
# Copy to .env and configure for local or cloud deployments
# =========================================================================

# Database Configuration (Defaults to local MySQL)
# For Aiven Cloud MySQL: jdbc:mysql://<host>:<port>/defaultdb?ssl-mode=REQUIRED
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/railway_congestion?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=1234Divyanshu

# Server Port
PORT=8084

# Frontend API URL
# For local development: http://localhost:8084
# For cloud production: https://railwatch-api.onrender.com
VITE_API_BASE_URL=http://localhost:8084
